# Copy this file to ".env" (same folder) and fill in your own values.
# Never commit your real ".env" file - it contains a secret token.

# The packaged `npx @fincons-group/azure-dashboard` flow does NOT need AZDO_PAT /
# AZDO_ORG here - it stores PAT + org in the browser and forwards them per
# request to the local API. Keep the vars below only for legacy hosted/server
# deployments or local development without the packaged CLI.

# Azure DevOps Personal Access Token (Settings > Personal Access Tokens in Azure DevOps).
# Needs read access to Test Plans and Work Items.
AZDO_PAT=your-personal-access-token-here

# Your Azure DevOps organization name (the part right after dev.azure.com/ in your URL).
AZDO_ORG=your-organization-name

# Your Azure DevOps project name. A SINGLE project name only, not a
# comma-separated list (the ScopeBar's project dropdown is what lets users
# work across multiple projects - this is just the fallback default used
# when a request doesn't specify one).
AZDO_PROJECT=your-project-name

# There is no sign-in wall - anyone who can reach this server can read
# dashboard data. Access is effectively gated by AZDO_PAT above: if it's
# valid, data loads; if not, the API returns 502s and the dashboard renders
# an empty screen. Put this behind a VPN/firewall/reverse-proxy auth layer
# if that's not restrictive enough for your deployment.

# Comma-separated list of origins allowed to call this API (CORS).
# Include your GitHub Pages URL in production, e.g.:
# https://your-org.github.io
CORS_ORIGIN=http://localhost:3000

# Drives the Sprint Report's "Bugs by Suite" / Azione 2 verifica-activity
# summary (see computeVerificaActivitySummary in src/defectData.ts).

# Comma-separated allowlist of assignees counted as "verifica" activity.
# Each entry is either a bare domain (matches any address @that domain) or a
# full email address (matched exactly). Default: anyone @finconsgroup.com.
TEAMS_VERIFICA_ASSIGNEE_ALLOWLIST=finconsgroup.com

# IANA timezone used to determine "today" for that summary.
TEAMS_VERIFICA_TIMEZONE=Europe/Rome

# Scheduled Teams notifications (src/notificationTriggers.ts,
# src/teamsNotifier.ts) - separate from the two vars above, which only feed
# the Sprint Report's verifica-activity summary. These checks aren't
# scheduled by this process itself (the Render free tier sleeps when idle,
# so an in-process cron would silently miss ticks) - instead
# .github/workflows/notify-teams-cron.yml wakes this server with an HTTP
# call at each trigger time (17:45 bugs-created-today, 09:00 and 14:00
# verifica-check, Mon-Fri Europe/Rome).

# Master switch - both triggers below stay silent (sendTeamsMessage is a
# no-op) unless this is "true".
ENABLE_TEAMS_NOTIFICATIONS=false

# Shared secret the GitHub Actions workflow must send as the x-cron-secret
# header to POST /internal/notify/*. Generate a random value (e.g.
# `openssl rand -base64 24`) and set the same value here and as this repo's
# CRON_SECRET Actions secret - there's no default, so the endpoints refuse
# every request (503) until this is set.
INTERNAL_CRON_SECRET=

# Teams webhook that gets the 17:45 "bugs created today" card. Stays silent
# on days with zero bugs created.
TEAMS_WEBHOOK_URL_BUGS_REPORTED=

# Teams webhook that gets the 09:00/14:00 "bugs waiting Da verificare" card.
# Stays silent when nothing is currently in that state.
TEAMS_WEBHOOK_URL_ASSIGNEE_VERIFICA=

# Comma-separated allowlist (same bare-domain-or-full-address shape as
# TEAMS_VERIFICA_ASSIGNEE_ALLOWLIST above) - the 09:00/14:00 check only
# reports bugs whose assignee matches this. Default: anyone @finconsgroup.com.
# TEAMS_VERIFICA_ALLOWED_SENDERS=finconsgroup.com

# Optional: name used in the bugs-created-today card's greeting
# ("Hey <name>, N bug(s) were created today"). Defaults to "team".
# TEAMS_GREETING_NAME=team

# Optional: IANA timezone used to determine "today" for the bugs-created
# check. Defaults to Europe/Rome.
# TEAMS_SUMMARY_TIMEZONE=Europe/Rome

# Optional: Azure DevOps project the verifica-check queries, if bugs sent to
# verifica live in a different project than AZDO_PROJECT. Falls back to
# AZDO_PROJECT when unset.
# TEAMS_VERIFICA_PROJECT=

# Powers the E2E History page (src/firebaseE2eData.ts) - Playwright run
# results published from the tst-e2e repo's CI pipeline. Optional: leave
# unset and the page shows a "not configured yet" hint instead of an error.
# See docs/e2e-firebase-integration-plan.md for full setup steps.

# The FULL JSON contents of a Firebase service-account key (Firebase Console
# > Project Settings > Service accounts > Generate new private key), as a
# single-line string. Treat this like a password - never commit a real
# value. The same value is used as a CI secret in tst-e2e's
# notification/firebase/publish-results-to-firebase.ts to WRITE run
# results; this server only ever READS with it.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Dev-only: absolute path to a local tst-e2e checkout's report output
# (Playwright/SmartReport `runs/` folder), served at /e2e-reports so the E2E
# History page's "View" link opens a real report while testing locally.
# Leave unset in every other deployment - the real pipeline publishes
# reportUrl pointing at wherever CI uploads the report instead.
# E2E_REPORTS_DIR=/path/to/tst-e2e/reports/runs

# Dev-only: absolute path to a local tst-e2e checkout's whole `reports/`
# folder (the parent of its runs/, a11y/, and zap/ subfolders), served at
# /test-suites-reports so the Test Suites page's "Open ..." links open a
# real smart-report.html / a11y/index.html / ZAP report while testing
# locally. Leave unset in every other deployment. Also reused by
# `npm run e2e:publish-spec-catalog` below to locate the checkout root.
# TEST_SUITES_REPORTS_DIR=/path/to/tst-e2e/reports

# Local-only: run `node scripts/publish-spec-catalog.js` (needs
# TEST_SUITES_REPORTS_DIR and FIREBASE_SERVICE_ACCOUNT_JSON above) to scan a
# real tst-e2e checkout for Playwright spec files and publish the list to the
# `testSpecCatalogLocal` Firestore collection - this is what powers the
# "Automated spec files" tab (AutomationKpiPage.tsx) on the hosted
# deployment, which has no tst-e2e checkout of its own to scan. No env var
# needed to run it; delete this script once tst-e2e's own CI publishes the
# list directly (see docs/tst-e2e-reports-followups.md).

# Temporary, local-only: required to run `npm run e2e:publish-local`, which
# reads TEST_SUITES_REPORTS_DIR above and writes run summaries into the
# `testSuiteRunsLocal` Firestore collection - never the collection the real
# tst-e2e CI pipeline will publish to (see
# docs/e2e-firebase-integration-plan.md Part C). This var is just a
# confirmation gate so the publish script never fires by accident; the
# cleanup counterpart (`npm run e2e:cleanup-local`) needs no gate since it
# only ever deletes from testSuiteRunsLocal. Delete both scripts and this var
# once CI is publishing for real.
# E2E_LOCAL_PUBLISH=true

# Separate opt-in from E2E_LOCAL_PUBLISH above: that one only writes small
# Firestore documents, this one additionally uploads each run's report
# file(s) to Firebase Storage and sets reportUrl on the document (see
# TestSuiteRun.reportUrl in src/types.ts) - real quota usage, not just a
# safety confirmation, so it defaults off even when E2E_LOCAL_PUBLISH=true.
# Requires the Firebase project to be on the Blaze plan (Storage isn't
# available on the free Spark plan).
# PUBLISH_REPORTS_TO_FIREBASE=true
