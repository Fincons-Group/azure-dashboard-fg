# Copy this file to ".env" (same folder) and fill in your own values.

# Skips the Microsoft sign-in screen entirely. Must match SKIP_AUTH in the
# root .env. Handy for local tryouts; leave unset (or "false") for anything
# resembling a real deployment.
VITE_SKIP_AUTH=true

# Shows the "Email report" option in the dashboard's export menu. Must
# match ENABLE_EMAIL_REPORT in the root .env (the server enforces it too).
VITE_ENABLE_EMAIL_REPORT=false

# Shows the "Release Readiness" nav tab/page. Must match
# ENABLE_RELEASE_READINESS in the root .env (the server enforces it too).
VITE_ENABLE_RELEASE_READINESS=false

# Restricts the UI to only /defects and /release-readiness. Must match
# SHOW_ONLY_DEFECT_AND_RELEASE in the root .env.
VITE_SHOW_ONLY_DEFECT_AND_RELEASE=false

# Azure Entra ID app registration details (Azure Portal > App registrations).
# Not used while VITE_SKIP_AUTH=true above, so the placeholder values below
# are fine to leave as-is for a local tryout.
VITE_ENTRA_TENANT_ID=your-tenant-id
VITE_ENTRA_CLIENT_ID=your-client-id
VITE_ENTRA_API_SCOPE=api://your-client-id/access_as_user
VITE_ENTRA_REDIRECT_URI=http://localhost:3000

# Separate app registration used by the frontend-delegated Graph mail flow -
# the report "Send by email" button and the Test Graph Mail button both send
# via Graph's /me/sendMail using the signed-in user's own delegated
# Mail.Send permission (no backend involved). Distinct from VITE_ENTRA_*
# above - register a second Entra app (SPA, redirect URI same as above),
# grant it delegated Mail.Send + User.Read, and put its IDs here.
VITE_MAIL_ENTRA_TENANT_ID=your-tenant-id
VITE_MAIL_ENTRA_CLIENT_ID=your-client-id

# Default recipient(s)/CC for the report "Send by email" button.
# Comma-separated. Just the initial values shown in the To/Cc fields on the
# report card - editable per send from there, not enforced.
VITE_SEND_MAIL_TO=your-email@example.com
VITE_SEND_MAIL_CC=

# Base URL of the backend API. Leave empty for local dev (Vite proxies /api
# to localhost:3001 - see vite.config.ts). In production, set this to your
# deployed backend URL, e.g. https://azure-dashboard-api.onrender.com
VITE_API_BASE_URL=
