{
  "name": "@acahet/azure-dashboard",
  "version": "0.1.0",
  "description": "poc",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "bin": {
    "azure-dashboard": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "server"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "prebuild": "tsc -p tsconfig.package.json",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "cross-env PORT=3001 tsx watch src/server.ts",
    "dev:client": "npm run dev --prefix client",
    "dev:all": "concurrently \"npm:dev\" \"npm:dev:client\"",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:client",
    "start": "tsx src/server.ts",
    "kill:dev": "node scripts/kill-dev.js"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.19.0",
    "@azure/msal-node": "^5.6.0",
    "axios": "^1.18.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jwks-rsa": "^3.2.0",
    "open": "^11.0.1",
    "sirv": "^3.0.2",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.3.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
